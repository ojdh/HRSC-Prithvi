// Production Worker configuration for prithvifc.ca, provisioned as described in
// README "Deploying to Cloudflare". None of these values are secrets;
// CLUB_SETUP_KEY, CF_ACCOUNT_ID and CF_API_TOKEN are set with `wrangler secret put`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hrsc-prithvi",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Daily R2 clean-up run by worker/index.ts. Cron Triggers are part of Workers Free.
  "triggers": { "crons": ["17 9 * * *"] },
  "workers_dev": false,
  "routes": [{ "pattern": "prithvifc.ca", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hrsc-prithvi",
      "database_id": "cfdb594e-a9d5-477d-a1de-d9354b26ac56",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "hrsc-prithvi-media" }],
  "vars": {
    "CF_ACCESS_TEAM_URL": "https://autumn-brook-58da.cloudflareaccess.com",
    "CF_ACCESS_AUD": "7cca58822bdff5c34ccfc687c0044cb2212a3fd902037eb4afdaca90e0af43a8",
    // Free-tier guardrails enforced by lib/r2-budget.ts. Keep each below R2's
    // free tier (10 GB-month, 1M Class A, 10M Class B per month); see AGENTS.md.
    "R2_STORAGE_QUOTA_BYTES": "8000000000",
    "R2_CLASS_A_MONTHLY_LIMIT": "500000",
    "R2_CLASS_B_MONTHLY_LIMIT": "5000000",
    // Access sync (lib/access-sync.ts): inviting a player with an email adds it to
    // the "Club members" Access group. CF_ACCOUNT_ID and CF_API_TOKEN are secrets;
    // while either is missing, such invites fail with "Access sync isn't
    // configured". See docs/cloudflare.md "Access sync on invite".
    "CF_ACCESS_GROUP_ID": "5d25cb40-e308-43c6-9731-d34436be0b72"
  }
}
